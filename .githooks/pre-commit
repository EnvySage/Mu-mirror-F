#!/usr/bin/env bash
# 1. 拒绝过大的文本文件：约 5000 token / 20 KB。
# 2. 高风险改动必须同时更新文档，防止文档过期和文档泛滥。
set -euo pipefail

limit=20000
failed=0
skip_re='(^|/)(package-lock\.json|.*\.lock|.*\.min\..*|generated|dist|build|target|node_modules|public/art|public/preview|docs/archive|docs/2026-10-20-ai-agent-architecture-v2.md|eval/agent_v2/reports)(/|$)|(^|/)deploy/demo_data\.sql$|(^|/)schema\.sql$|(^|/).*[Cc]atalog.*\.json$|(^|/).*manifest\.json$|\.(png|jpe?g|webp|gif|ico|ttf|woff2?|mp3|wav|m4a|mp4|pdf|docx)$'

while IFS= read -r -d '' file; do
  [[ "$file" =~ $skip_re ]] && continue
  [ -f "$file" ] || continue
  bytes=$(wc -c < "$file")
  if [ "$bytes" -gt "$limit" ]; then
    printf '提交被拦截：%s 为 %s bytes（上限 %s）。请按功能拆成几个文件后再提交。\n' "$file" "$bytes" "$limit" >&2
    failed=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "$failed" -ne 0 ]; then
  exit "$failed"
fi

files=$(git diff --cached --name-only --diff-filter=ACM)
risky=$(printf '%s\n' "$files" | grep -E '^(src/(api|router|stores)/|vite\.config\.js$|package\.json$|\.env\.example$)' || true)
docs=$(printf '%s\n' "$files" | grep -E '^(README\.md|docs/.*\.md)$' | grep -v '^docs/archive/' || true)
code=$(printf '%s\n' "$files" | grep -E '^(src/|vite\.config\.js$|package\.json$|\.env\.example$|scripts/)' || true)

if [ -n "$risky" ] && [ -z "$docs" ] && [ "${SKIP_DOC_CHECK:-0}" != "1" ]; then
  cat >&2 <<'EOF'
提交被拦截：这次改动涉及 API / 路由 / 状态 / 构建或环境配置，但没有更新文档。
请在同一提交里更新对应文档：
  - 启动与构建：README.md
  - 界面规范：docs/ui-redesign.md
  - 记录流程：docs/record-workflow.md
  - 跨端状态：../Mu-mirror-B/docs/PROGRESS.md
确属无需更新文档的紧急情况，可用 SKIP_DOC_CHECK=1 提交，并在提交说明里写明原因。
EOF
  exit 1
fi

if [ -n "$code" ] && [ -z "$docs" ]; then
  printf '提示：本次提交有代码改动但没有文档改动。请确认 README 或 docs/ 不需要更新。\n' >&2
fi
